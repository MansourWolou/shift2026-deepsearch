OPENROUTER_MAX_TOKENS=900

FAST_OPENAI_MODEL=gpt-4o-mini
FAST_MISTRAL_MODEL=mistral/mistral-small-latest
OTEL_SERVICE_NAME=agent-orchestrator-telemetry
